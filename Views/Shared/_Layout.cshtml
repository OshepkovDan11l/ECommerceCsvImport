<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Импорт товаров</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Products" asp-action="Index">ECommerceCsvImport</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Товары</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Import">Импорт</a></li>
            </ul>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
